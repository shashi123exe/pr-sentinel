# ==============================================================================
# PR Sentinel — Render Single-Service Production Dockerfile (Multi-stage)
# Builds React SPA frontend and FastAPI Python backend into a single container image.
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build React Frontend & Install ESLint Tooling (Debian-based Node 22 slim)
# ------------------------------------------------------------------------------
FROM node:22-slim AS node-builder

WORKDIR /build/frontend

# Copy frontend dependency manifests first for build caching
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Copy full frontend source code and compile production assets
COPY frontend/ ./
RUN npm run build

# Install isolated backend ESLint dependencies
WORKDIR /build/tools/eslint
COPY backend/tools/eslint/package.json backend/tools/eslint/package-lock.json ./
RUN npm ci

# ------------------------------------------------------------------------------
# Stage 2: Python Dependency Builder
# ------------------------------------------------------------------------------
FROM python:3.12-slim AS python-builder

WORKDIR /build/backend

# Install compilation tools for binary wheels if needed
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc python3-dev && \
    rm -rf /var/lib/apt/lists/*

# Create virtual environment and install dependencies
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY backend/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ------------------------------------------------------------------------------
# Stage 3: Minimal Single-Service Runtime Image
# ------------------------------------------------------------------------------
FROM python:3.12-slim AS runner

WORKDIR /app

# Runtime environment settings
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app" \
    SERVE_FRONTEND="true" \
    FRONTEND_DIST_DIR="/app/frontend/dist" \
    PORT=10000

# Copy Node.js binary from node builder so backend ESLint runner can execute
COPY --from=node-builder /usr/local/bin/node /usr/local/bin/node

# Create unprivileged application user and storage directories
RUN groupadd -g 1000 appuser && \
    useradd -u 1000 -g appuser -s /bin/bash -m appuser && \
    mkdir -p /app/data /app/frontend/dist /app/app /app/tools/eslint && \
    chown -R appuser:appuser /app

# Copy isolated virtualenv from python builder
COPY --from=python-builder --chown=appuser:appuser /opt/venv /opt/venv

# Copy compiled frontend assets from node builder
COPY --from=node-builder --chown=appuser:appuser /build/frontend/dist /app/frontend/dist

# Copy backend application package and static analysis tooling
COPY --chown=appuser:appuser backend/app /app/app
COPY --chown=appuser:appuser backend/tools /app/tools
COPY --from=node-builder --chown=appuser:appuser /build/tools/eslint/node_modules /app/tools/eslint/node_modules

# Switch to non-root user
USER appuser

# Document default web service port
EXPOSE 10000

# Health check using existing /api/health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request, os, sys; port = os.getenv('PORT', '10000'); sys.exit(0 if urllib.request.urlopen(f'http://localhost:{port}/api/health', timeout=3).getcode() == 200 else 1)"

# Start single-worker Uvicorn production server with proxy headers support
# Single worker (--workers 1) ensures SQLite/PostgreSQL and in-memory concurrency locks are strictly respected.
# Literal '*' in --forwarded-allow-ips='*' trusts proxy headers from Render's edge reverse proxy.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1 --proxy-headers --forwarded-allow-ips='*'"]
