# ==============================================================================
# PR Sentinel — Environment Configuration Template
# ==============================================================================
# Instructions:
# - For Docker: Copy this file to .env at the project root or configure in backend/.env.
# - For Local Dev: Copy this file to backend/.env.
# - DO NOT commit real API keys or sensitive credentials to version control.
# ==============================================================================

# Google Gemini API Key (Required for AI pull request reviews)
GEMINI_API_KEY=

# Gemini Model Identifier (Optional; e.g., gemini-2.5-pro or gemini-3.5-flash)
# If omitted, resolved from database app_settings or environment configuration
GEMINI_MODEL=

# GitHub Personal Access Token (Optional; increases rate limit for public PRs or accesses private repos)
GITHUB_TOKEN=

# SQLAlchemy Database Connection URL
# For Docker: sqlite:////app/data/pr_sentinel.db (uses persistent volume)
# For Local Dev: sqlite:///./pr_sentinel.db
DATABASE_URL=sqlite:////app/data/pr_sentinel.db

# Allowed CORS Origins (Comma-separated)
# For Docker: http://localhost:8080,http://127.0.0.1:8080
# For Local Dev: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Application Shared Access Token (Optional; shared bearer token gate for API endpoints)
# If omitted or empty, access gating is disabled.
APP_ACCESS_TOKEN=

# Daily Review Limit (Optional; rolling 24-hour limit to prevent LLM quota exhaustion; 0 disables)
MAX_REVIEWS_PER_DAY=50
